# Copiar a .env y ajustar si hace falta (todas las variables tienen un valor por defecto razonable)

PORT=3000
DATA_DIR=./data
MAX_UPLOAD_MB=50
MAX_CONCURRENT_RENDERS=2
MAX_AGE_MINUTES=120
CORS_ORIGIN=*

# Solo si quieres usar tu propio ffmpeg del sistema en vez del que trae ffmpeg-static:
# FFMPEG_PATH=/usr/bin/ffmpeg
